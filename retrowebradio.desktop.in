[Desktop Entry]
Type=Application
Name=RetroWebRadio
GenericName=Web Radio
GenericName[de]=Webradio
Comment=Web radio with the dial of an old tube radio (mpd)
Comment[de]=Webradio mit der Skala eines alten Röhrenradios (mpd)
Exec=@BINDIR@/retrowebradio-tray --show
Path=@BINDIR@
Icon=retrowebradio
Terminal=false
Categories=AudioVideo;Audio;Player;
StartupWMClass=retrowebradio
Actions=radio;display;

[Desktop Action radio]
Name=Radio
Exec=@BINDIR@/retrowebradio-tray --show --radio

[Desktop Action display]
Name=Display only
Name[de]=Nur Display
Exec=@BINDIR@/retrowebradio-tray --show --display
