#!/usr/bin/env python3
"""
RetroWebRadio tray icon (panel indicator, like Onboard's).

Left click:         menu (show or hide radio, depending on the window
                    state, play/pause, louder, quieter, mute, quit);
                    the title is in the tooltip
Right click:        show/hide the radio window (roehre)
Middle click:       mute on/off
Scroll wheel:       volume up/down
The icon shows a pause badge when paused/stopped, a slash when muted.

Uses Gtk.StatusIcon (classic system tray). For panels that only show
AppIndicators (e.g. GNOME with the AppIndicator extension) start it with
RETROWEBRADIO_TRAY=indicator. Talks to mpd through mpc; state updates come from
`mpc idleloop`, so volume changes made elsewhere show up immediately.

GNU GENERAL PUBLIC LICENSE Version 3
"""
import fcntl
import os
import shutil
import signal
import subprocess
import sys
import warnings

# our options (--display!) must not reach GTK's own argument parsing
ARGS = sys.argv[1:]
del sys.argv[1:]

import gi  # noqa: E402
gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk, Gdk  # noqa: E402


def load_indicator():
    # a registered StatusNotifier host does not mean the panel shows the
    # items, so auto-detection is unreliable: classic tray unless asked
    if os.environ.get("RETROWEBRADIO_TRAY", "statusicon") != "indicator":
        return None
    # the GTK3 appindicator libs are deprecated upstream but still work
    GLib.log_set_handler("libayatana-appindicator", GLib.LogLevelFlags.LEVEL_WARNING,
                         lambda *a: None)
    for name in ("AyatanaAppIndicator3", "AppIndicator3"):
        try:
            gi.require_version(name, "0.1")
            return getattr(__import__("gi.repository", fromlist=[name]), name)
        except (ValueError, ImportError):
            pass
    return None

STEP = 5                # volume step in percent

# Gtk.StatusIcon is deprecated in GTK3 but still the most widely shown tray
warnings.filterwarnings("ignore", category=DeprecationWarning)

TEXTS = {
    "de": {
        "Show radio": "Radio anzeigen", "Hide radio": "Radio verbergen",
        "Play": "Abspielen", "Pause": "Pause",
        "Louder": "Lauter", "Quieter": "Leiser", "Mute": "Stumm",
        "Quit": "Beenden",
        "mpd not reachable": "mpd nicht erreichbar",
        "no volume control (mixer_type)": "keine Lautstärkeregelung (mixer_type)",
        "muted": "stumm", "volume %d%%": "Lautstärke %d%%",
        "paused": "pausiert", "stopped": "gestoppt",
    },
}


def _lang():
    for var in ("LC_ALL", "LC_MESSAGES", "LANG", "LANGUAGE"):
        val = os.environ.get(var)
        if val:
            return val.split(":")[0][:2]
    return "en"


_T = TEXTS.get(_lang(), {})


def _(text):
    return _T.get(text, text)
RESTORE_DEFAULT = 50    # unmute to this if the old volume is unknown
HERE = os.path.dirname(os.path.realpath(__file__))
ICON_DIR = next((d for d in (os.path.join(HERE, "icons"),
                             # make install: PREFIX/bin -> PREFIX/share/...
                             os.path.normpath(os.path.join(HERE, "..", "share",
                                                           "retrowebradio", "icons")),
                             "/usr/local/share/retrowebradio/icons")
                 if os.path.isfile(os.path.join(d, "retrowebradio.svg"))), None)


def mpc(*args):
    """Run mpc without a shell, return stdout or None on error."""
    try:
        r = subprocess.run(["mpc", *args], capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.stdout if r.returncode == 0 else None


def gui_visible():
    """Window state published by roehre (see publish_visibility)."""
    run = os.environ.get("XDG_RUNTIME_DIR")
    path = (os.path.join(run, "retrowebradio-visible") if run and run.startswith("/")
            else "/tmp/retrowebradio-%d-visible" % os.getuid())
    try:
        with open(path) as f:
            return f.read().strip() == "1"
    except OSError:
        return True  # older roehre without the file: assume visible


def find_roehre():
    for path in (os.path.join(HERE, "roehre"), shutil.which("roehre") or ""):
        if path and os.access(path, os.X_OK):
            return path
    return None


def icon_for(state):
    """state: '', 'muted' or 'offline' -> (file or None, theme icon name)"""
    name = "retrowebradio" + ("-" + state if state else "")
    fallback = {"": "audio-volume-high", "muted": "audio-volume-muted",
                "paused": "media-playback-pause",
                "offline": "audio-volume-muted"}[state]
    if ICON_DIR:
        return os.path.join(ICON_DIR, name + ".svg"), name
    return None, fallback


class Tray:
    def __init__(self, Indicator=None):
        self.volume = None        # None: mpd has no mixer / not reachable
        self.reachable = False
        self.shown_icon = None
        self.saved_volume = None  # volume before mute
        self.playing = False
        self.paused = False
        self.title = ""
        self.roehre = None        # Popen of the GUI started by us
        self.idle = None
        self.updating = False     # suppress callbacks while syncing widgets

        self.menu = self.build_menu()
        if Indicator is not None:
            self.ind = Indicator.Indicator.new(
                "retrowebradio", icon_for("")[1],
                Indicator.IndicatorCategory.APPLICATION_STATUS)
            if ICON_DIR:
                self.ind.set_icon_theme_path(ICON_DIR)
            self.ind.set_status(Indicator.IndicatorStatus.ACTIVE)
            self.ind.set_title("RetroWebRadio")
            self.ind.set_menu(self.menu)
            self.ind.set_secondary_activate_target(self.item_mute)
            self.ind.connect("scroll-event", self.on_indicator_scroll)
            self.icon = None
        else:
            self.ind = None
            self.icon = Gtk.StatusIcon()
            self.icon.set_title("RetroWebRadio")
            # left click: menu, right click: show/hide the radio window
            self.icon.connect("activate", self.on_left_click)
            self.icon.connect("popup-menu", lambda *_a: self.toggle_gui())
            self.icon.connect("scroll-event", self.on_icon_scroll)
            self.icon.connect("button-press-event", self.on_icon_button)

        self.refresh()
        self.start_idleloop()
        GLib.timeout_add_seconds(2, self.check_gui)

    # -------------------------------------------------------------- menu
    def build_menu(self):
        m = Gtk.Menu()
        # one entry, "show" or "hide" depending on the window state
        self.item_gui = Gtk.MenuItem(label=_("Show radio"))
        self.item_gui.connect("activate", lambda *_a: self.toggle_gui())
        m.append(self.item_gui)
        m.append(Gtk.SeparatorMenuItem())

        self.item_play = Gtk.MenuItem(label=_("Play"))
        self.item_play.connect("activate", lambda *_a: self.after(mpc("toggle")))
        m.append(self.item_play)
        m.append(Gtk.SeparatorMenuItem())

        for label, delta in ((_("Louder"), +STEP), (_("Quieter"), -STEP)):
            it = Gtk.MenuItem(label=label)
            it.connect("activate", lambda _w, d=delta: self.change_volume(d))
            m.append(it)

        self.item_mute = Gtk.CheckMenuItem(label=_("Mute"))
        self.item_mute.connect("toggled", self.on_mute_toggled)
        m.append(self.item_mute)
        m.append(Gtk.SeparatorMenuItem())

        quit_item = Gtk.MenuItem(label=_("Quit"))
        quit_item.connect("activate", lambda *_a: self.quit())
        m.append(quit_item)
        m.show_all()
        return m

    # ------------------------------------------------------------- state
    def refresh(self):
        out = mpc()  # plain `mpc`: title line, status line, volume line
        self.volume, self.playing, self.paused, self.title = None, False, False, ""
        self.reachable = out is not None
        if out is not None:
            lines = out.splitlines()
            for line in lines:
                if line.startswith("volume:"):
                    v = line.split()[1].rstrip("%")
                    self.volume = int(v) if v.isdigit() else None
            if len(lines) >= 3:  # something in the queue
                self.playing = lines[1].startswith("[playing]")
                self.paused = lines[1].startswith("[paused]")
                if not lines[0].startswith(("http", "mms://")):
                    self.title = lines[0]
        self.update_widgets()

    def update_widgets(self):
        muted = self.volume == 0
        if not self.reachable:
            kind, state = "offline", _("mpd not reachable")
        elif not self.playing:
            kind, state = "paused", _("paused") if self.paused else _("stopped")
        elif self.volume is None:
            kind, state = "", _("no volume control (mixer_type)")
        elif muted:
            kind, state = "muted", _("muted")
        else:
            kind, state = "", _("volume %d%%") % self.volume
        icon_file, icon_name = icon_for(kind)
        tip = "RetroWebRadio – %s" % state
        if self.title:
            tip += "\n" + self.title

        self.updating = True
        self.item_play.set_label(_("Pause") if self.playing else _("Play"))
        self.item_mute.set_active(muted)
        running = self.gui_running()
        self.item_gui.set_label(_("Hide radio") if running and gui_visible()
                                else _("Show radio"))
        self.item_gui.set_sensitive(running or find_roehre() is not None)
        self.updating = False

        if self.ind is not None:
            if self.shown_icon != (icon_name, state):
                self.ind.set_icon_full(icon_name, state)
            self.ind.set_title(tip)
        else:
            if self.shown_icon != (icon_name, state):
                if icon_file:
                    self.icon.set_from_file(icon_file)
                else:
                    self.icon.set_from_icon_name(icon_name)
            self.icon.set_tooltip_text(tip)
        self.shown_icon = (icon_name, state)

    def after(self, _result):
        self.refresh()

    # ------------------------------------------------------------ volume
    def change_volume(self, delta):
        if self.volume == 0 and delta > 0 and self.saved_volume:
            mpc("volume", str(self.saved_volume))  # louder while muted: unmute
        else:
            mpc("volume", "%+d" % delta)
        self.refresh()

    def set_mute(self, mute):
        if self.volume is None:
            return
        if mute and self.volume > 0:
            self.saved_volume = self.volume
            mpc("volume", "0")
        elif not mute and self.volume == 0:
            mpc("volume", str(self.saved_volume or RESTORE_DEFAULT))
        self.refresh()

    def on_mute_toggled(self, item):
        if not self.updating:
            self.set_mute(item.get_active())

    def on_indicator_scroll(self, _ind, _delta, direction):
        if direction == Gdk.ScrollDirection.UP:
            self.change_volume(+STEP)
        elif direction == Gdk.ScrollDirection.DOWN:
            self.change_volume(-STEP)

    def on_icon_scroll(self, _icon, event):
        self.on_indicator_scroll(None, 0, event.direction)

    def on_icon_button(self, _icon, event):
        if event.button == 2:
            self.set_mute(self.volume != 0)

    def on_left_click(self, icon):
        self.update_widgets()  # window state may have changed meanwhile
        self.menu.popup(None, None, Gtk.StatusIcon.position_menu, icon,
                        1, Gtk.get_current_event_time())

    def quit(self):
        """Quit everything: radio GUI, playback and the tray itself."""
        if self.gui_running():
            if self.roehre is not None and self.roehre.poll() is None:
                self.roehre.terminate()
            subprocess.run(["pkill", "-x", "roehre"])
        mpc("stop")
        if self.idle is not None and self.idle.poll() is None:
            self.idle.terminate()
        Gtk.main_quit()

    # --------------------------------------------------------------- GUI
    def gui_running(self):
        if self.roehre is not None and self.roehre.poll() is None:
            return True
        return subprocess.run(["pgrep", "-x", "roehre"],
                              stdout=subprocess.DEVNULL).returncode == 0

    def signal_gui(self, sig):
        """Show (SIGUSR1), hide (SIGUSR2) or toggle (SIGRTMIN) the window.
        roehre keeps running, so playback continues without a gap."""
        out = subprocess.run(["pgrep", "-x", "roehre"], capture_output=True, text=True).stdout
        for pid in out.split():
            try:
                os.kill(int(pid), sig)
            except (OSError, ValueError):
                pass

    def start_gui(self):
        exe = find_roehre()
        if exe:
            self.roehre = subprocess.Popen(
                [exe, "-d", "0"] + MODE_ARGS, cwd=os.path.dirname(exe),
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        GLib.timeout_add(300, lambda: self.update_widgets() and False)

    def show_gui(self):
        if self.gui_running():
            self.signal_gui(mode_signal() or signal.SIGUSR1)   # (switch,) show, raise
        else:
            self.start_gui()

    def toggle_gui(self):
        if not self.gui_running():
            self.start_gui()
        elif gui_visible():
            self.signal_gui(signal.SIGUSR2)   # hide
        else:
            self.signal_gui(signal.SIGUSR1)   # show and raise
        GLib.timeout_add(300, lambda: self.update_widgets() and False)

    def check_gui(self):
        if self.roehre is not None and self.roehre.poll() is not None:
            self.roehre = None
        self.update_widgets()
        return True

    # -------------------------------------------------- mpd notifications
    def start_idleloop(self):
        try:
            self.idle = subprocess.Popen(["mpc", "idleloop", "player", "mixer", "options"],
                                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        except OSError:
            GLib.timeout_add_seconds(5, self.retry_idleloop)
            return
        GLib.io_add_watch(self.idle.stdout, GLib.PRIORITY_DEFAULT,
                          GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self.on_idle)

    def on_idle(self, stream, condition):
        if condition & GLib.IO_IN and stream.readline():
            self.refresh()
            return True
        # mpd gone: show that and try again later
        self.idle.wait()
        self.refresh()
        GLib.timeout_add_seconds(5, self.retry_idleloop)
        return False

    def retry_idleloop(self):
        self.refresh()
        if self.reachable:
            self.start_idleloop()
            return False
        return True


def roehre_pids():
    out = subprocess.run(["pgrep", "-x", "roehre"], capture_output=True, text=True).stdout
    return [int(p) for p in out.split() if p.isdigit()]


def show_radio_detached():
    """Bring up the radio window without a tray of our own."""
    pids = roehre_pids()
    if pids:
        for pid in pids:
            try:
                os.kill(pid, mode_signal() or signal.SIGUSR1)
            except OSError:
                pass
        return
    exe = find_roehre()
    if exe:
        subprocess.Popen([exe, "-d", "0"] + MODE_ARGS, cwd=os.path.dirname(exe),
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)


def single_instance_lock():
    """Return an open, locked file, or None if another tray already runs."""
    run = os.environ.get("XDG_RUNTIME_DIR")
    path = (os.path.join(run, "retrowebradio-tray.lock") if run and run.startswith("/")
            else "/tmp/retrowebradio-tray-%d.lock" % os.getuid())
    f = open(path, "w")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        f.close()
        return None
    return f


USAGE = """usage: retrowebradio-tray [--show] [--radio | --display]
  --show     also show the radio window (start roehre if needed).
             If the tray is already running, only the window is shown.
  --radio    show it with the radio cabinet
  --display  show only the display (dial)
"""

MODE_ARGS = []   # passed to roehre: [] (as last time), ["--radio"], ["--display"]


def mode_signal():
    """Signal that switches a running roehre to the requested mode (and shows it)."""
    if MODE_ARGS == ["--radio"]:
        return signal.SIGRTMIN + 1
    if MODE_ARGS == ["--display"]:
        return signal.SIGRTMIN + 2
    return None


def main():
    args = ARGS
    known = ("--show", "--radio", "--display")
    if any(a in ("-h", "--help") for a in args) or any(a not in known for a in args) \
            or ("--radio" in args and "--display" in args):
        sys.stdout.write(USAGE)
        sys.exit(0 if args and args[0] in ("-h", "--help") else 2)
    MODE_ARGS[:] = [a for a in args if a in ("--radio", "--display")]
    show = "--show" in args or bool(MODE_ARGS)

    if shutil.which("mpc") is None:
        sys.exit("retrowebradio-tray: mpc not found (sudo apt install mpc)")
    lock = single_instance_lock()
    if lock is None:  # tray already there (e.g. started from the menu twice)
        if show:
            show_radio_detached()
        return
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    tray = Tray(load_indicator())
    if show:
        GLib.idle_add(lambda: tray.show_gui() and False)
    Gtk.main()
    lock.close()


if __name__ == "__main__":
    main()
